# Supabase 연결 (값은 .env.local 또는 Vercel Environment Variables에 설정, 커밋 금지)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# (선택) DELIN — 정식 RELEASE 제외. 기본: 로컬 development·Vercel Preview 만 on, Production off
# 강제: true|false|1|0|on|off
# NEXT_PUBLIC_DELIN_ENABLED=

# (선택) OAuth redirectTo 기준 URL — 프로덕션예: https://smart.autofankorea.com
# 로컬에서는 비우거나 http://localhost:3000 (프로덕션 URL이면 로그인 후 그쪽으로 이동)
# NEXT_PUBLIC_SITE_URL=

# (선택) Capacitor Android WebView 로드 URL — 기본은 capacitor.config.ts 내 배포 URL
# CAPACITOR_SERVER_URL=https://smart.autofankorea.com

# Android 네이티브 OAuth (앱 로그인). 값은 .env.local / Vercel에만.
# Google: Cloud Console "웹" 클라이언트 ID (Android serverClientId로도 사용)
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 카카오: 개발자 콘솔 네이티브 앱 키 (OpenID Connect ON 필수)
# KAKAO_NATIVE_APP_KEY=
# NEXT_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Android APK 설치 페이지 (/app) — 서버 전용. 값만 .env.local / Vercel에.
# APP_INSTALL_PASSWORD=
# (선택) 쿠키 서명용. 없으면 APP_INSTALL_PASSWORD 사용
# APP_INSTALL_COOKIE_SECRET=
# APP_APK_VERSION=1.0.0
# APP_APK_BUCKET=app-releases
# APP_APK_OBJECT_PATH=sungil-iot.apk

# 서버 전용 (관리자 작업). 절대 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Edge Function push-dispatch 전용 (Supabase Secrets — 로컬 .env에 넣지 말 것)
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# (선택) 관리자 허브 지도 카카오맵 Web SDK (JavaScript 키). 도메인 등록 필요. 없으면 Leaflet.
# KAKAO_JS_KEY=
# NEXT_PUBLIC_KAKAO_JS_KEY=

# (선택) Geocode — 농장 도로명 주소 → 필지 좌표 (서버 전용). 없으면 시·면 중심만.
# KAKAO_REST_API_KEY=

# (선택) Playwright audit — 기본 http://localhost:3000 (dev 서버 실행 중)
# UI_VERIFY_BASE=http://127.0.0.1:3000

# (선택) LIVE read tier: `list` (default) | `legacy` (full decoded_json on list)
# NEXT_PUBLIC_LIVE_READ_TIER=list

# /farm 그리드·목록 → «현장» 통합 (기본 on). false|0|off 이면 그리드·목록·차트 분리
# NEXT_PUBLIC_FARM_FIELD_MERGE_V1=true

# (선택) Health 수집 그룹 — farmKeyId 배열 JSON. 미설정 시 농장 목록을 반으로 나눔.
# HEALTH_COLLECTOR_GROUPS={"col-a":["FARM01/P00","FARM02/P00"],"col-b":["FARM06/P00"]}
