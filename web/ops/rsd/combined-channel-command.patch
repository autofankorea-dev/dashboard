+def command_channels(row: dict) -> list[dict]:
+    raw = (row.get("payload_json") or {}).get("command_channels")
+    if not isinstance(raw, list) or not 1 <= len(raw) <= 3:
+        raise CommandError("command_channels must contain 1..3 channels")
+    out = []
+    seen = set()
+    for channel in raw:
+        if not isinstance(channel, dict):
+            raise CommandError("invalid command channel")
+        slot = _normalize_channel(channel.get("channel"))
+        code = _normalize_eqpmn_code(channel.get("eqpmnCode"))
+        if slot in seen:
+            raise CommandError("duplicate command channel")
+        seen.add(slot)
+        values = {"setpoint_temp": channel.get("setpointTemp"), "temp_deviation": channel.get("tempDeviation"),
+                  "min_vent_pct": channel.get("minVentPct"), "max_vent_pct": channel.get("maxVentPct")}
+        for field, value in values.items():
+            if isinstance(value, bool) or not isinstance(value, (int, float)):
+                raise CommandError("invalid numeric channel value")
+            number = _to_decimal(value, field)
+            if not number.is_finite() or (number * (10 if field in ("setpoint_temp", "temp_deviation") else 1)) % 1:
+                raise CommandError("invalid channel precision")
+        _validate_thermo_values(values)
+        out.append({**channel, "channel": slot, "eqpmnCode": code})
+    return sorted(out, key=lambda c: c["channel"])
+
+
+def build_combined_command_wire_bytes(row: dict) -> bytes:
+    channels = command_channels(row)
+    body = bytearray([0xFF] * 27)
+    body[:6] = bytes([0x0D, 0, _stall_ty_to_wire(_normalize_stall_ty(row["stall_ty_code"])),
+                      int(_normalize_stall_no(row["stall_no"])), int(_normalize_eqpmn_no(row["eqpmn_no"])), 0])
+    for channel in channels:
+        slot = CHANNEL_TO_WIRE[channel["channel"]]
+        body[5] |= 1 << slot
+        off = 6 + slot * 7
+        body[off:off + 7] = struct.pack("<BHHBB", _eqpmn_code_to_wire(channel["eqpmnCode"]),
+            _temp_to_x10(_to_decimal(channel["setpointTemp"], "setpointTemp")),
+            _temp_to_x10(_to_decimal(channel["tempDeviation"], "tempDeviation")),
+            channel["minVentPct"], channel["maxVentPct"])
+    return bytes(body) + struct.pack("<H", crc16_ccitt_false(body))
+
