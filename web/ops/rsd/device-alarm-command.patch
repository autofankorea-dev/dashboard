+def command_alarms(row: dict) -> dict:
+    raw = (row.get("payload_json") or {}).get("alarm_settings")
+    if not isinstance(raw, dict):
+        raise CommandError("alarm_settings required")
+    values = []
+    for key in ("lowTempC", "highTempC"):
+        v = raw.get(key)
+        if isinstance(v, bool) or not isinstance(v, (int, float)):
+            raise CommandError("invalid alarm number")
+        n = _to_decimal(v, key)
+        if not n.is_finite() or not 0 <= n <= 100 or n * 10 % 1:
+            raise CommandError("invalid alarm range or precision")
+        values.append(n)
+    if values[0] >= values[1]:
+        raise CommandError("low alarm must be below high alarm")
+    return raw
+
